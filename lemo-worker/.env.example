LEMO_ENABLED=false
LEMO_DEFAULT_STYLE_MODE=auto
LEMO_STYLE_LIBRARY=cloudbath-original-v1
LEMO_ORIGINAL_STYLE_VERIFIED=false
# For this owner's private studio and own/team/client films, use owner-films.
# This uses the upstream ADDITIONAL PERMISSION FOR THE DOCS, not a SaaS licence.
LEMO_FILM_USE_APPROVED=false
LEMO_PRIVATE_OWNER_MODE=false
MOTION_DEFAULT_TTS_MODEL=eleven_v4
MOTION_DEFAULT_SFX_MODEL=eleven_text_to_sound_v3
LEMO_LICENSE_APPROVED=false
# LEMO_LICENSE_APPROVED applies only to LEMO_STYLE_LIBRARY=upstream-licensed.
# Original directions use the verified MIT helper and do not load private STYLE.md.
LEMO_SECURITY_VERIFIED=false
LEMO_RENDER_VERIFIED=false
LEMO_V4_VERIFIED=false
LEMO_SFX_V3_VERIFIED=false
LEMO_THAI_SYNC_VERIFIED=false
LEMO_COST_VERIFIED=false
LEMO_CLASSIC_REGRESSION_VERIFIED=false
LEMO_PRIVATE_LIBRARY=/private/lemo-library
# Alternatively provision LEMO_PRIVATE_STYLES_JSON privately on the coordinator:
# a JSON object mapping installed style IDs to exact pinned STYLE.md contents.
# Never commit its value or pass it to the rendering sandbox.
LEMO_EXECUTOR_URL=https://your-private-executor.example
LEMO_EXECUTOR_TOKEN=
LEMO_SANDBOX_IMAGE=sha256:REPLACE_WITH_VERIFIED_IMAGE_DIGEST
MOTION_CREATIVE_RATES_JSON={}
# Reference existing Railway variables for DATABASE_URL, BUCKET*, R2*, OPENAI_API_KEY,
# ELEVENLABS_API_KEY and MOTION_DEFAULT_VOICE_ID; do not duplicate their values here.
